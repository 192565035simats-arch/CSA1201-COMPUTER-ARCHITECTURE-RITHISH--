#include <stdio.h>

int main() {
    int octal, decimal = 0;
    int remainder, base = 1;

    printf("Enter an octal number: ");
    scanf("%d", &octal);

    while (octal > 0) {
        remainder = octal % 10;
        decimal = decimal + remainder * base;
        octal = octal / 10;
        base = base * 8;
    }

    printf("Decimal number = %d\n", decimal);

    return 0;
}