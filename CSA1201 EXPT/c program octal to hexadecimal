#include <stdio.h>

int main() {
    int octal, decimal = 0, remainder, base = 1;
    char hex[20];
    int i = 0;

    printf("Enter an octal number: ");
    scanf("%d", &octal);

    // Octal to Decimal
    while (octal > 0) {
        remainder = octal % 10;
        decimal = decimal + remainder * base;
        octal = octal / 10;
        base = base * 8;
    }

    // Decimal to Hexadecimal
    if (decimal == 0) {
        printf("Hexadecimal number = 0\n");
        return 0;
    }

    while (decimal > 0) {
        remainder = decimal % 16;

        if (remainder < 10)
            hex[i] = remainder + '0';
        else
            hex[i] = remainder - 10 + 'A';

        decimal = decimal / 16;
        i++;
    }

    printf("Hexadecimal number = ");

    while (i > 0)
        printf("%c", hex[--i]);

    printf("\n");

    return 0;
}