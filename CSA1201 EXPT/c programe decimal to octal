#include <stdio.h>

int main()
{
    int decimal, octal[32], i = 0;

    printf("Enter a decimal number: ");
    scanf("%d", &decimal);

    while (decimal > 0)
    {
        octal[i] = decimal % 8;
        decimal = decimal / 8;
        i++;
    }

    printf("Octal number: ");

    for (i = i - 1; i >= 0; i--)
    {
        printf("%d", octal[i]);
    }

    return 0;
}